#!/bin/sh
# Before every commit (installed by `npm install`: core.hooksPath = scripts/git-hooks).
# 1. Show what is staged, so a commit can't quietly carry deletions or renames from earlier `git rm`/`git mv`.
# 2. Every commit passes the full check on its own (typecheck, tests, architecture, the leak check, build), so
#    history can be bisected. This is the only per-commit pass: nothing re-runs it over a branch later.
#    It checks the commit itself, not the working tree: with unstaged or untracked files about, the staged snapshot
#    is checked out in a throwaway worktree and checked there, so a file the commit leaves out can't make it pass.
#    A clean tree is the snapshot, so it's checked where it stands (faster: no checkout).
# 3. Before both, the commit carries the owner's identity (scripts/owner.sh), so no real name or personal email
#    reaches public history. `git var` sees what the commit will really use: config, environment or --author.
# Never skip this with --no-verify: fix what it finds instead.
set -e

. "$(dirname "$0")/../owner.sh"
for who in AUTHOR COMMITTER; do
  ident=$(git var "GIT_${who}_IDENT")
  name=${ident%% <*}
  email=${ident#*<}
  email=${email%%>*}
  if [ "$name" != "$OWNER_NAME" ] || [ "$email" != "$OWNER_EMAIL" ]; then
    echo "pre-commit: wrong identity: this commit's $(echo "$who" | tr 'A-Z' 'a-z') would be $name <$email>." >&2
    echo "pre-commit: commits here carry only $OWNER_NAME <$OWNER_EMAIL>. In this checkout:" >&2
    echo "  git config user.name $OWNER_NAME && git config user.email $OWNER_EMAIL" >&2
    exit 1
  fi
done

staged=$(git diff --cached --name-status)
if [ -z "$staged" ]; then
  echo "pre-commit: nothing staged." >&2
  exit 1
fi
added=$(printf '%s\n' "$staged" | grep -c '^A' || true)
modified=$(printf '%s\n' "$staged" | grep -c '^M' || true)
deleted=$(printf '%s\n' "$staged" | grep -c '^D' || true)
renamed=$(printf '%s\n' "$staged" | grep -c '^R' || true)
echo "pre-commit: committing $added added, $modified modified, $deleted deleted, $renamed renamed." >&2
printf '%s\n' "$staged" | grep -E '^(D|R)' | sed 's/^/  /' >&2 || true

top=$(pwd)
log="$top/.git-check.log"
here="$top"
if ! git diff --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  # The index git hands this hook (GIT_INDEX_FILE) is exactly what the commit will hold: snapshot it, then let go of
  # it, so the worktree commands below keep their own index and never touch this one.
  tree=$(git write-tree)
  parent=$(git rev-parse -q --verify HEAD || true)
  snap=$(git commit-tree "$tree" ${parent:+-p "$parent"} -m "pre-commit snapshot")
  unset GIT_INDEX_FILE GIT_DIR GIT_WORK_TREE
  here=$(mktemp -d "${TMPDIR:-/tmp}/liveline-pre-commit.XXXXXX")
  # Remove only this worktree (a prune would touch every worktree of the repository, other sessions' included)
  trap 'git -C "$top" worktree remove --force "$here" 2>/dev/null; rm -rf "$here"' EXIT
  git worktree add -q --detach "$here" "$snap"
  # Installed packages and the local leak words aren't in git: share this checkout's
  [ -e "$top/node_modules" ] && ln -s "$top/node_modules" "$here/node_modules"
  [ -e "$top/notes" ] && ln -s "$top/notes" "$here/notes"
  echo "pre-commit: checking the staged snapshot (unstaged or untracked files are about)." >&2
fi

(cd "$here" && npm run --silent check) > "$log" 2>&1 || {
  echo "pre-commit: npm run check failed on what's staged; the output is in .git-check.log. Fix it before committing." >&2
  tail -20 "$log" >&2
  exit 1
}
rm -f "$log"
